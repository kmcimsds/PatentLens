# 이 파일은 예시입니다. 실제 키를 여기에 넣지 마세요.
# 프로젝트 루트에 이 파일을 복사해 ".env.local"로 이름을 바꾼 뒤,
# 아래 두 값을 각 서비스에서 발급받은 실제 키로 교체하세요.

# 선택 사항: 서버 기본 키 (사용자 BYOK가 없을 때만 사용)
# 배포 환경에서는 사용자 키 입력을 권장합니다.
SERPAPI_KEY=your_serpapi_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 선택 사항: 비워 두면 코드 기본값(gemini-3.6-flash)을 사용합니다.
# 모델이 폐기되면 여기서 최신 모델명으로 덮어쓸 수 있습니다.
GEMINI_MODEL=

# 선택: IP당 분석 rate limit (기본 10회/60초)
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000
